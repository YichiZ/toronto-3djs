{
  "name": "toronto-3djs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive Three.js digital twin of Union Station and downtown Toronto",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "qa": "node qa/run-qa.mjs",
    "test": "node --test \"qa/*.test.mjs\"",
    "capture": "node qa/capture.mjs",
    "e2e": "node --test --test-concurrency=1 qa/*.e2e.mjs",
    "e2e:perf": "vite build && node --test --test-concurrency=1 qa/*.perf.mjs"
  },
  "dependencies": {
    "three": "^0.171.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "vite": "^6.0.0"
  }
}
